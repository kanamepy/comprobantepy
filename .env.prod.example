# Configuración para docker-compose.prod.yml. Copiar a .env y completar.
# Dominio que apunta a este servidor (registro DNS tipo A). Caddy obtiene el certificado HTTPS.
DOMINIO=comprobantes.ejemplo.com.py
URL_PUBLICA=https://comprobantes.ejemplo.com.py

# Contraseñas de la base: largas y distintas.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=

# Clave de cifrado de 32 bytes en base64. GUARDALA APARTE: sin ella no se recuperan los archivos.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO=

SESION_HORAS=12
TAMANO_MAXIMO_ARCHIVO_MB=20

# Gmail (opcional, ver README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORREO_INTERVALO_MINUTOS=5

# Respaldo diario a las 2 de la mañana, se guardan en ./respaldos del servidor.
RESPALDO_DIARIO_HORA=2
RESPALDOS_CONSERVAR=14

# Antivirus: levantar con --profile antivirus y descomentar.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
