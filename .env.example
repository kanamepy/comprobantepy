# Copiar a .env y ajustar.
DATABASE_URL=postgres://comprobantepy:comprobantepy@localhost:5432/comprobantepy
PORT=3000
NODE_ENV=development
# Duración de la sesión en horas.
SESION_HORAS=12
# Almacenamiento de objetos (MinIO en desarrollo; R2/S3 en producción). Se usará desde la Fase 1.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=comprobantes
S3_ACCESS_KEY=comprobantepy
S3_SECRET_KEY=comprobantepy-secreto
# Clave para cifrar datos sensibles (secretos TOTP, tokens, números de cuenta).
# Generarla una vez con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guardarla en un lugar seguro: si se pierde, no se pueden descifrar los datos.
CLAVE_CIFRADO=
