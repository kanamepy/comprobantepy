{
  "name": "@comprobantepy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrar.ts",
    "crear-usuario": "tsx src/scripts/crear-usuario.ts",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "medir-lectura": "tsx src/scripts/medir-lectura.ts"
  },
  "dependencies": {
    "@comprobantepy/shared": "0.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@googleapis/gmail": "^22.0.1",
    "@napi-rs/canvas": "^0.1.100",
    "@tesseract.js-data/spa": "^1.0.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "jsqr": "^1.4.0",
    "mailparser": "^3.9.37",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.4",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
