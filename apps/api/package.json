{
  "name": "@comprobantepy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrar.ts",
    "crear-usuario": "tsx src/scripts/crear-usuario.ts"
  },
  "dependencies": {
    "@comprobantepy/shared": "0.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.4",
    "jszip": "^3.10.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
